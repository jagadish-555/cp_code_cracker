// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}
  
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}



model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String?  @db.VarChar(20)
  usernameLower String?  @db.VarChar(20)
  password      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  authAccounts     AuthAccount[]
  platformAccounts PlatformAccount[]
  platformStats    PlatformStats[]
  streak           Streak?
  dailyActivities  DailyActivity[]
  userProblems     UserProblem[]
  friendsInitiated Friendship[] @relation("FriendshipInitiator")
  friendsReceived  Friendship[] @relation("FriendshipReceiver")
  contestReminders ContestReminder[]

  @@unique([usernameLower])
}



model AuthAccount {
  id             String   @id @default(uuid())
  provider       String   @db.VarChar(20) 
  providerUserId String   @db.VarChar(255)
  createdAt      DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
}


model Streak {
  id             String   @id @default(uuid())
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  maxStreak      Int      @default(0)
  lastActiveDate DateTime?
  updatedAt      DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}



model DailyActivity {
  id            String   @id @default(uuid())
  date          DateTime 
  activityCount Int      @default(0)
  updatedAt     DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}


model PlatformAccount {
  id        String   @id @default(uuid())
  platform  Platform
  handle    String   @db.VarChar(50)
  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

model PlatformStats {
  id            String   @id @default(uuid())
  platform      Platform
  
  // Common fields
  rating        Int?
  solved        Int?
  
  // Codeforces specific
  maxRating     Int?
  title         String?
  
  // LeetCode specific
  easySolved    Int?
  mediumSolved  Int?
  hardSolved    Int?
  
  // CodeChef specific
  stars         Int?
  
  // Raw data for any platform-specific info
  rawData       Json?
  updatedAt     DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}


enum Platform {
  cf   // Codeforces
  lc   // LeetCode
  cc   // CodeChef
  ac   // AtCoder
}

model Problem {
  id                String   @id @default(uuid())
  platform          Platform
  platformProblemId String   @db.VarChar(100) 
  title             String   @db.VarChar(255)
  difficulty        String?  @db.VarChar(50)  
  tags              Json?                      
  url               String   @db.VarChar(500)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userProblems UserProblem[]

  @@unique([platform, platformProblemId])
  @@index([platform])
  @@index([difficulty])
}

model UserProblem {
  id         String              @id @default(uuid())
  userId     String
  problemId  String
  status     UserProblemStatus   @default(attempted)
  attempts   Int                 @default(1)
  solvedAt   DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId, status])
}

enum UserProblemStatus {
  attempted
  solved
}

model Friendship {
  id         String           @id @default(uuid())
  status     FriendshipStatus @default(pending)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  requesterId String
  addresseeId String

  requester User @relation("FriendshipInitiator", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipReceiver", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
  @@index([status])
}

enum FriendshipStatus {
  pending
  accepted
  rejected
}
model Contest {
  id             String   @id @default(uuid())
  clistId        String   @unique @db.VarChar(50)
  resource       String   @db.VarChar(100)  // "codeforces.com", "leetcode.com", etc
  host           String   @db.VarChar(100)  // "Codeforces", "LeetCode", etc
  event          String   @db.VarChar(255)  // Contest name
  startTime      DateTime
  endTime        DateTime
  duration       Int?                       // Duration in seconds
  href           String   @db.VarChar(500)  // URL to contest
  nProblems      Int?                       // Number of problems
  parsedAt       DateTime @default(now())   // When the contest was fetched from clist.by
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reminders ContestReminder[]

  @@index([startTime])
  @@index([resource])
  @@index([clistId])
}

model ContestReminder {
  id           String   @id @default(uuid())
  reminderTime DateTime // When to send the reminder
  notified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId   String
  contestId String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest  Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([userId, contestId])
  @@index([userId])
  @@index([reminderTime])
  @@index([notified])
}